SPECTARR_DATABASE_URL=postgresql+psycopg://spectarr:spectarr@postgres:5432/spectarr
SPECTARR_STORAGE_ROOT=/data/storage
SPECTARR_LIBRARY_ROOT=/data/storage/library
# auto prefers zero-copy hard links and falls back to copies across filesystems.
SPECTARR_LIBRARY_LINK_MODE=auto
SPECTARR_LIBRARY_PROJECT_TEMPLATE={project_name}__{project_id:8}
SPECTARR_LIBRARY_FILENAME_TEMPLATE={run_name}__{sample_name}__{run_id:8}{extension}
SPECTARR_SCRATCH_ROOT=/data/scratch
SPECTARR_API_URL=http://api:8000
SPECTARR_PUBLIC_API_URL=http://localhost:8280
SPECTARR_API_PORT=8280
SPECTARR_MCP_PORT=8281
SPECTARR_DASHBOARD_PORT=3280
# Keep local mode bound to this machine unless remote no-login access is intentional.
SPECTARR_BIND_ADDRESS=127.0.0.1
SPECTARR_UID=1000
SPECTARR_GID=1000
SPECTARR_API_KEY=
SPECTARR_WORKER_TOKEN=replace-with-a-long-random-value
SPECTARR_AUTH_ENABLED=true
SPECTARR_AUTH_MODE=password
SPECTARR_SESSION_HOURS=24
SPECTARR_LOCAL_USER=admin
SPECTARR_ALLOW_REMOTE_NO_AUTH=false
SPECTARR_SECRET_KEY=replace-with-at-least-32-random-characters
SPECTARR_EXTRACTOR_TOKEN=
SPECTARR_INSTALL_OPENMASSSPEC=true
SPECTARR_SPECTRUM_READER_TIMEOUT_SECONDS=30
SPECTARR_MCP_ALLOW_WRITES=false
SPECTARR_WEBHOOK_ALLOW_HTTP=false
# Override when the Docker daemon sees this repository at a different absolute path.
# SPECTARR_DOCKER_DATA_ROOT=/absolute/path/to/spectarr/data
SPECTARR_MSCONVERT_IMAGE=proteowizard/pwiz-skyline-i-agree-to-the-vendor-licenses:3.0.23310
POSTGRES_DB=spectarr
POSTGRES_USER=spectarr
POSTGRES_PASSWORD=spectarr
