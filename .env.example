SPECTARR_PORT=3280
SPECTARR_MCP_PORT=8281
SPECTARR_BIND_ADDRESS=127.0.0.1
SPECTARR_UID=1000
SPECTARR_GID=1000

SPECTARR_AUTH_MODE=password
SPECTARR_LOCAL_USER=admin
SPECTARR_ALLOW_REMOTE_NO_AUTH=false
SPECTARR_SESSION_HOURS=24
SPECTARR_SECRET_KEY=replace-with-at-least-32-random-characters
SPECTARR_WORKER_TOKEN=replace-with-an-independent-random-value

SPECTARR_LIBRARY_LINK_MODE=auto
SPECTARR_LIBRARY_PROJECT_TEMPLATE={project_name}__{project_id:8}
SPECTARR_LIBRARY_FILENAME_TEMPLATE={run_name}__{sample_name}__{run_id:8}{extension}

SPECTARR_REMOTE_IMPORTS_ENABLED=true
# Concurrent PRIDE file transfers, from 1 through 8.
SPECTARR_REMOTE_DOWNLOAD_CONCURRENCY=2

SPECTARR_INSTALL_OPENMASSSPEC=true
SPECTARR_SPECTRUM_READER_TIMEOUT_SECONDS=30
SPECTARR_MSCONVERT_IMAGE=proteowizard/pwiz-skyline-i-agree-to-the-vendor-licenses:skyline_26.1.0.266-578b175@sha256:448a833eb92eac2ca731f2461c046963c0c2afafb3550b4dfb6fc3914cec7b0e

SPECTARR_MCP_ALLOW_WRITES=false
# Set the client-visible endpoint when using a custom MCP port or reverse proxy.
SPECTARR_MCP_PUBLIC_URL=
SPECTARR_API_KEY=
SPECTARR_WEBHOOK_ALLOW_HTTP=false
SPECTARR_WEBHOOK_ALLOW_PRIVATE_NETWORKS=false

# Exact DNS hostnames allowed to reach the API. Literal IP addresses are accepted.
SPECTARR_TRUSTED_HOSTS=["localhost"]
# Optional bearer token for HTTP MCP clients. Keep the published port on loopback.
SPECTARR_MCP_TOKEN=
