SPECTARR_VERSION=0.3.0
SPECTARR_IMAGE=ghcr.io/pgarrett-scripps/spectarr
SPECTARR_BIND_ADDRESS=127.0.0.1
SPECTARR_PORT=3280
SPECTARR_MCP_PORT=8281
SPECTARR_UID=1000
SPECTARR_GID=1000
SPECTARR_DATA_DIR=./data
# Bulk artifact storage (source files and the readable library). Defaults to
# living inside the data directory. Point it at large or network storage while
# keeping SPECTARR_DATA_DIR (the SQLite database) on local disk.
SPECTARR_STORAGE_DIR=
SPECTARR_IMPORT_DIR=./imports
SPECTARR_DOCKER_DATA_ROOT=
SPECTARR_SECRET_KEY=
SPECTARR_WORKER_TOKEN=
SPECTARR_AUTH_MODE=password
SPECTARR_LOCAL_USER=admin
SPECTARR_ALLOW_REMOTE_NO_AUTH=false
SPECTARR_MCP_ALLOW_WRITES=false
SPECTARR_API_KEY=
SPECTARR_WEBHOOK_ALLOW_HTTP=false
SPECTARR_WEBHOOK_ALLOW_PRIVATE_NETWORKS=false

# Optional existing backup directory. Use compose.backups.yaml to mount it.
# Configure scheduling and retention in Settings > Backups after mounting.
SPECTARR_BACKUP_DIR=
# Compatible image or digest to record for independent backup verification.
SPECTARR_BACKUP_IMAGE=
