SPECTARR_VERSION=0.1.0
SPECTARR_IMAGE=ghcr.io/pgarrett-scripps/spectarr
SPECTARR_BIND_ADDRESS=127.0.0.1
SPECTARR_PORT=3280
SPECTARR_MCP_PORT=8281
SPECTARR_UID=1000
SPECTARR_GID=1000
SPECTARR_DATA_DIR=./data
SPECTARR_IMPORT_DIR=./imports
SPECTARR_DOCKER_DATA_ROOT=/absolute/path/to/spectarr/data
SPECTARR_SECRET_KEY=replace-with-at-least-32-random-characters
SPECTARR_WORKER_TOKEN=replace-with-an-independent-random-value
SPECTARR_AUTH_MODE=password
SPECTARR_LOCAL_USER=admin
SPECTARR_ALLOW_REMOTE_NO_AUTH=false
SPECTARR_MCP_ALLOW_WRITES=false
SPECTARR_API_KEY=
SPECTARR_WEBHOOK_ALLOW_HTTP=false
SPECTARR_WEBHOOK_ALLOW_PRIVATE_NETWORKS=false
